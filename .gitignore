*.pyc

# Gradio caches every image it serves. app.py redirects it to the system temp
# directory, but list it anyway so an accidental run from a stale environment
# cannot commit ~2000 cache files.
gradio/
dbd-skillcheck/
_probe_profile*/
_chrome_profile*/
_*profile*/
shot_*.png
